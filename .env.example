# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (public browser/server URL + anon key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service role. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# AI providers (configure at least one for live AI)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional SEO/content integrations
SEMRUSH_API_KEY=
SURFER_API_KEY=
JASPER_API_KEY=

# Optional agency CRM integration
GHL_API_KEY=
GHL_LOCATION_ID=

# Security/config
RESEARCH_USER_AGENT=UpTrendifyOSBot/1.0 (+https://example.com)
MAX_RESEARCH_PAGES=15
MAX_RESEARCH_BYTES=5000000
RESEARCH_TIMEOUT_MS=12000
