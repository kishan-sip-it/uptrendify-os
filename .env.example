# UpTrendifyOS environment variables
# NEVER commit .env.local or real secrets.

# -----------------------------
# App
# -----------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------
# Supabase - LOCAL DEVELOPMENT
# Supabase CLI prints these when `npx supabase start` runs:
#   Local URL      -> http://127.0.0.1:54321
#   Publishable    -> use for browser/client access
#   Secret         -> use only on the trusted server side
# For this project's variable names, map them as:
#   NEXT_PUBLIC_SUPABASE_ANON_KEY = LOCAL PUBLISHABLE KEY
#   SUPABASE_SERVICE_ROLE_KEY    = LOCAL SECRET KEY
# -----------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------
# Supabase - HOSTED / VERCEL
# Replace the local values above in Vercel with the hosted project URL
# and hosted publishable/anon key + hosted service/secret key.
# -----------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_HOSTED_PUBLISHABLE_OR_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_HOSTED_SERVICE_ROLE_OR_SECRET_KEY

# -----------------------------
# AI providers
# -----------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
DEFAULT_AI_PROVIDER=gemini

# Optional providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

SEMRUSH_API_KEY=
SURFER_API_KEY=
JASPER_API_KEY=
GHL_API_KEY=
GHL_LOCATION_ID=

# -----------------------------
# Research limits
# -----------------------------
RESEARCH_USER_AGENT=UpTrendifyOSBot/1.0 (+https://example.com)
MAX_RESEARCH_PAGES=15
MAX_RESEARCH_BYTES=5000000
MAX_RESEARCH_REDIRECTS=5
RESEARCH_TIMEOUT_MS=12000
RESEARCH_TOTAL_BUDGET_MS=45000